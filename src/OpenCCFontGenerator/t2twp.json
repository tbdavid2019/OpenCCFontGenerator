{
  "name": "Traditional Chinese to Traditional Chinese (Taiwan standard, with phrases)",
  "segmentation": {
    "type": "mmseg",
    "dict": {
      "type": "group",
      "match_policy": "union",
      "dicts": [
        {
          "type": "text",
          "file": "./opencc_data/TWPhrases.txt"
        },
        {
          "type": "text",
          "file": "./opencc_data/TWVariantsPhrases.txt"
        }
      ]
    }
  },
  "conversion_chain": [
    {
      "dict": {
        "type": "group",
        "match_policy": "short_circuit",
        "dicts": [
          {
            "type": "text",
            "file": "./opencc_data/TWPhrases.txt"
          },
          {
            "type": "text",
            "file": "./opencc_data/TWVariantsPhrases.txt"
          },
          {
            "type": "text",
            "file": "./opencc_data/TWVariants.txt"
          }
        ]
      }
    }
  ]
}
